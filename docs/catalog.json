{
  "packages": [
    {
      "id": "evtxecmd",
      "name": "EvtxECmd",
      "kind": "tool",
      "description": "Parse Windows event logs into one consistent set of columns across every provider.",
      "version": "2026.5.0.0",
      "versions": [
        "2026.5.0.0"
      ],
      "platforms": [
        {
          "os": "windows",
          "arch": "x64"
        }
      ],
      "stability": "rolling",
      "about": "EvtxECmd reads Windows .evtx logs and normalises them, so that events written by different providers end up in the same shape rather than each carrying its own XML payload. Map files stored beside the executable say which fields are worth pulling out for a given provider and event ID; an event with no map is still reported, with its payload intact. Output is CSV, JSON or XML, and a whole directory of logs can be processed into one file.",
      "disciplines": [
        {
          "key": "windows-forensics",
          "label": "Windows forensics"
        }
      ],
      "capabilities": [
        {
          "key": "event-log-parsing",
          "label": "Event log parsing"
        },
        {
          "key": "timeline-generation",
          "label": "Timeline generation"
        },
        {
          "key": "data-export",
          "label": "Data export"
        }
      ],
      "use_cases": [
        {
          "key": "incident-response",
          "label": "Incident response"
        },
        {
          "key": "threat-hunting",
          "label": "Threat hunting"
        },
        {
          "key": "forensic-triage",
          "label": "Forensic triage"
        }
      ],
      "evidence": [
        {
          "key": "windows-event-logs",
          "label": "Windows event logs"
        }
      ],
      "commands": [
        "evtxecmd"
      ],
      "project": {
        "homepage": "https://ericzimmerman.github.io/",
        "repository": "https://github.com/EricZimmerman/evtx",
        "license": "MIT"
      }
    },
    {
      "id": "hayabusa",
      "name": "Hayabusa",
      "kind": "tool",
      "description": "Analyze Windows event logs, build forensic timelines, and apply Sigma-based detections.",
      "version": "4.0.0",
      "versions": [
        "4.0.0"
      ],
      "platforms": [
        {
          "os": "windows",
          "arch": "x64"
        },
        {
          "os": "linux",
          "arch": "x64"
        },
        {
          "os": "macos",
          "arch": "arm64"
        }
      ],
      "about": "Hayabusa reads a directory of Windows .evtx files and produces a single consolidated timeline, applying bundled Sigma detection rules as it goes so that matching activity is labelled with a severity. It supports the Sigma specification including v2 correlation rules, and can output to CSV, JSON and several other formats for review in other tools. The detection rules ship with the release and can be updated separately from the binary.",
      "disciplines": [
        {
          "key": "windows-forensics",
          "label": "Windows forensics"
        }
      ],
      "capabilities": [
        {
          "key": "event-log-parsing",
          "label": "Event log parsing"
        },
        {
          "key": "timeline-generation",
          "label": "Timeline generation"
        },
        {
          "key": "sigma-detection",
          "label": "Sigma rule detection"
        },
        {
          "key": "data-export",
          "label": "Data export"
        }
      ],
      "use_cases": [
        {
          "key": "forensic-triage",
          "label": "Forensic triage"
        },
        {
          "key": "incident-response",
          "label": "Incident response"
        },
        {
          "key": "threat-hunting",
          "label": "Threat hunting"
        }
      ],
      "evidence": [
        {
          "key": "windows-event-logs",
          "label": "Windows event logs"
        }
      ],
