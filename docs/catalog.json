    {
      "id": "sqlecmd",
      "name": "SQLECmd",
      "kind": "tool",
      "description": "Find SQLite databases and export them using maps describing known applications.",
      "version": "2026.5.0.0",
      "versions": [
        "2026.5.0.0"
      ],
      "platforms": [
        {
          "os": "windows",
          "arch": "x64"
        }
      ],
      "stability": "rolling",
      "about": "SQLECmd walks a directory or a mounted image looking for SQLite databases, identifies each one against a set of maps naming the application that wrote it, and runs the queries those maps define. A database is recognised by the filename its map expects; hunting mode instead reads every file's header, which finds databases that have been renamed at the cost of examining everything. The maps ship beside the executable and cover Windows applications alongside iOS and Android databases. Output is CSV, one file per query.",
      "disciplines": [
        {
          "key": "windows-forensics",
          "label": "Windows forensics"
        },
        {
          "key": "smartphone-forensics",
          "label": "Smartphone forensics"
        }
      ],
      "capabilities": [
        {
          "key": "data-export",
          "label": "Data export"
        }
      ],
      "use_cases": [
        {
          "key": "forensic-triage",
          "label": "Forensic triage"
        },
        {
          "key": "evidence-review",
          "label": "Evidence review and reporting"
        }
      ],
      "evidence": [
        {
          "key": "sqlite-databases",
          "label": "SQLite databases"
        }
      ],
      "commands": [
        "sqlecmd"
      ],
      "project": {
        "homepage": "https://ericzimmerman.github.io/",
        "repository": "https://github.com/EricZimmerman/SQLECmd",
        "license": "MIT"
      }
    },
    {
      "id": "yara",
      "name": "YARA",
      "kind": "tool",
      "description": "Scan files and memory for rules describing textual or binary patterns.",
      "version": "4.5.5",
      "versions": [
        "4.5.5"
      ],
      "platforms": [
        {
          "os": "windows",
          "arch": "x64"
        }
      ],
      "about": "YARA matches files, directories and running processes against rules that describe the strings and byte sequences a family of software contains. Each match is reported with the rule that fired and where in the file it occurred. Rules are plain text and portable, so detections written by one team can be applied unchanged by another, and the same rule set can be run over collected files or over a memory image.",
      "disciplines": [
        {
          "key": "malware-analysis",
          "label": "Malware analysis"
        }
      ],
      "capabilities": [
        {
          "key": "signature-scanning",
          "label": "Signature scanning"
        },
        {
          "key": "string-extraction",
          "label": "String extraction"
        }
      ],
      "use_cases": [
        {
          "key": "threat-hunting",
          "label": "Threat hunting"
        },
        {
          "key": "incident-response",
          "label": "Incident response"
        }
      ],
      "evidence": [
        {
          "key": "files",
          "label": "Files of any kind"
        },
        {
          "key": "memory-images",
          "label": "Memory images"
        }
      ],
      "commands": [
        "yara",
        "yarac"
      ],
      "project": {
        "homepage": "https://virustotal.github.io/yara/",
        "repository": "https://github.com/VirusTotal/yara",
