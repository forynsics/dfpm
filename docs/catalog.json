      }
    },
    {
      "id": "mftecmd",
      "name": "MFTECmd",
      "kind": "tool",
      "description": "Parse NTFS metadata files and export records as CSV, JSON, or a timeline body file.",
      "version": "2026.5.0.0",
      "versions": [
        "2026.5.0.0"
      ],
      "platforms": [
        {
          "os": "windows",
          "arch": "x64"
        }
      ],
      "stability": "rolling",
      "about": "MFTECmd reads the metadata files NTFS keeps about itself: $MFT, $J, $Boot, $SDS and $LogFile. For each record it reports the file name, the reconstructed path, the attributes and the timestamps, and writes the result as CSV, JSON, or a body file for building a timeline. Both the $STANDARD_INFORMATION and $FILE_NAME timestamps are reported, so records whose dates disagree can be found rather than taken at face value.",
      "disciplines": [
        {
          "key": "windows-forensics",
          "label": "Windows forensics"
        }
      ],
      "capabilities": [
        {
          "key": "file-system-parsing",
          "label": "File system parsing"
        },
        {
          "key": "timeline-generation",
          "label": "Timeline generation"
        },
        {
          "key": "data-export",
          "label": "Data export"
        }
      ],
      "use_cases": [
        {
          "key": "forensic-triage",
          "label": "Forensic triage"
        },
        {
          "key": "incident-response",
          "label": "Incident response"
        },
        {
          "key": "evidence-review",
          "label": "Evidence review and reporting"
        }
      ],
      "evidence": [
        {
          "key": "master-file-table",
          "label": "NTFS master file table"
        },
        {
          "key": "usn-journal",
          "label": "NTFS change journal"
        }
      ],
      "commands": [
        "mftecmd"
      ],
      "project": {
        "homepage": "https://ericzimmerman.github.io/",
        "repository": "https://github.com/EricZimmerman/MFTECmd",
        "license": "MIT"
      }
    },
    {
      "id": "pecmd",
      "name": "PECmd",
      "kind": "tool",
      "description": "Parse Windows Prefetch files to show which programs ran, when, and what they loaded.",
      "version": "2026.5.0.0",
      "versions": [
        "2026.5.0.0"
      ],
      "platforms": [
        {
          "os": "windows",
          "arch": "x64"
        }
      ],
      "stability": "rolling",
      "about": "PECmd reads the Prefetch files Windows writes when a program is executed. Each one gives the executable's name, how many times it has been run, the last several run times, the volumes involved, and the files and directories the program touched while starting up. Output is CSV or JSON, and a separate timeline file puts every recorded run time on its own row so executions can be read in order.",
      "disciplines": [
        {
          "key": "windows-forensics",
          "label": "Windows forensics"
        }
      ],
      "capabilities": [
        {
          "key": "timeline-generation",
          "label": "Timeline generation"
        },
        {
          "key": "data-export",
          "label": "Data export"
        }
      ],
      "use_cases": [
        {
          "key": "forensic-triage",
          "label": "Forensic triage"
        },
        {
          "key": "incident-response",
          "label": "Incident response"
        },
        {
          "key": "threat-hunting",
          "label": "Threat hunting"
        }
      ],
      "evidence": [
        {
          "key": "prefetch-files",
          "label": "Prefetch files"
        }
      ],
      "commands": [
        "pecmd"
      ],
      "project": {
        "homepage": "https://ericzimmerman.github.io/",
        "repository": "https://github.com/EricZimmerman/PECmd",
        "license": "MIT"
      }
    },
    {
      "id": "recmd",
      "name": "RECmd",
      "kind": "tool",
      "description": "Search and export Windows registry hives from the command line, including dirty ones.",
      "version": "2026.5.0.0",
      "versions": [
        "2026.5.0.0"
      ],
      "platforms": [
        {
          "os": "windows",
          "arch": "x64"
        }
      ],
      "stability": "rolling",
      "about": "RECmd opens registry hives directly rather than through the running system, and replays transaction logs so a hive copied from a live machine can still be read. Keys, values and data can be searched by string or regular expression, or a batch file can name a set of keys to pull out in one pass. Plugins decode values whose contents are not plain text, such as the binary structures behind shellbags and application compatibility data. Output is CSV.",
      "disciplines": [
        {
          "key": "windows-forensics",
          "label": "Windows forensics"
        }
      ],
      "capabilities": [
        {
          "key": "registry-parsing",
          "label": "Registry parsing"
        },
        {
          "key": "data-export",
          "label": "Data export"
        }
      ],
      "use_cases": [
