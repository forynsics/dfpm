{
  "schema_version": 1,
  "id": "sleuthkit",
  "name": "The Sleuth Kit",
  "kind": "tool",
  "description": "Inspect disk images and file systems with a collection of focused command-line tools.",
  "about": "The Sleuth Kit provides low-level commands for examining storage evidence without requiring a graphical case application. Its tools describe partition tables and file systems, list directory and inode metadata, extract file contents, inspect data blocks and journals, recover allocated or deleted files, and load results into a database. The official Windows package is a 32-bit build; it runs on 64-bit Windows through Windows' built-in x86 compatibility support.",
  "disciplines": [],
  "capabilities": [
    "file-system-parsing",
    "file-carving",
    "hash-matching",
    "data-export"
  ],
  "use_cases": [
    "incident-response",
    "forensic-triage",
    "evidence-review"
  ],
  "evidence": [
    "disk-images"
  ],
