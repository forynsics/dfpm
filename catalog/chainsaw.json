{
  "schema_version": 1,
  "id": "chainsaw",
  "name": "Chainsaw",
  "kind": "tool",
  "description": "Search and detect across Windows artifacts at speed, applying Sigma rules to event logs and more.",
  "about": "Chainsaw searches Windows forensic artifacts quickly and applies detection logic to what it finds. It reads event logs, and also the master file table, shimcache, shellbags, SRUM and registry hives, so one pass covers several artifact types rather than one. Detections come from Sigma rules translated through the mapping files shipped beside the executable, which say how a rule's fields correspond to what each log actually contains. Results print as a table or timeline, or export as CSV or JSON. **The Sigma rules themselves are not included in this build** and must be supplied with the appropriate option; the mappings that interpret them are. The Linux builds need glibc 2.34 or newer, as shipped by Ubuntu 22.04, Debian 12 and RHEL 9 onwards.",
  "disciplines": [
    "windows-forensics"
  ],
  "capabilities": [
    "sigma-detection",
    "event-log-parsing",
    "timeline-generation",
    "data-export"
  ],
  "use_cases": [
    "threat-hunting",
    "incident-response",
    "forensic-triage"
  ],
  "evidence": [
    "windows-event-logs",
    "registry-hives",
    "master-file-table"
  ],
  "project": {
    "homepage": "https://github.com/WithSecureOpenSource/chainsaw",
    "repository": "https://github.com/WithSecureOpenSource/chainsaw",
    "license": "GPL-3.0-only"
  },
