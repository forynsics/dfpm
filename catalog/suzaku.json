{
  "schema_version": 1,
  "id": "suzaku",
  "name": "Suzaku",
  "kind": "tool",
  "description": "Search cloud audit logs, generate forensic timelines, and apply Sigma-based detections.",
  "about": "Suzaku brings Hayabusa's timeline-and-detection workflow to exported cloud logs. The current release searches and summarizes AWS CloudTrail data, produces CloudTrail metrics and DFIR timelines, and builds Azure timelines, applying its bundled Sigma rules to surface matching activity. It works on log files supplied locally; it does not connect to or modify a cloud account. The Linux x64 build is statically linked; the arm64 build needs glibc 2.39 or newer, as shipped by Ubuntu 24.04 and Debian 13 onwards.",
  "disciplines": [
    "cloud-forensics"
  ],
  "capabilities": [
    "sigma-detection",
    "timeline-generation",
    "data-export"
  ],
  "use_cases": [
    "incident-response",
    "forensic-triage",
    "threat-hunting"
  ],
  "evidence": [
    "cloud-audit-logs"
  ],
