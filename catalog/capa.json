{
  "schema_version": 1,
  "id": "capa",
  "name": "capa",
  "kind": "tool",
  "description": "Identify what an executable is capable of, expressed as named behaviours rather than signatures.",
  "about": "capa examines a program and reports what it can do: encrypt data, log keystrokes, persist through a registry run key, communicate over HTTP, inject into another process. It reaches those conclusions from rules describing combinations of imported functions, strings, constants and control flow, so a match names a behaviour rather than a particular family or sample. That makes it useful on something never seen before, where a signature has nothing to match. It reads executables, shellcode and sandbox reports, prints its findings as a table or as JSON, and can show the evidence behind each match so a conclusion can be checked rather than trusted. The Linux builds unpack themselves into the temporary directory each time it starts, so it will not run where that directory is mounted without permission to execute.",
  "disciplines": [
    "malware-analysis"
  ],
  "capabilities": [
    "signature-scanning",
    "data-export"
  ],
  "use_cases": [
    "threat-hunting",
    "incident-response",
    "evidence-review"
  ],
  "evidence": [
    "files"
  ],
