{
  "schema_version": 1,
  "id": "memprocfs",
  "name": "MemProcFS",
  "kind": "tool",
  "description": "Mount a memory image as a file system and browse processes, handles and network activity as files.",
  "about": "MemProcFS presents a memory image the way an operating system presents a disk: as a tree of directories and files. Each process becomes a folder holding its modules, handles, threads, virtual memory map and recovered files, so examining memory becomes reading and copying rather than running a query and interpreting a table. It reads raw dumps, crash dumps and hibernation files, and can also attach to live memory through a driver. A plugin directory extends what appears in the tree, and a bundled rule engine allows scanning the mounted image for known patterns. Mounting it as a drive letter needs a file system driver installed separately; without one the same data is reachable through its other interfaces. On Linux it will not start without the distribution's FUSE 2 and libusb 1.0 libraries (libfuse2 and libusb-1.0-0 on Debian and Ubuntu), and mounting needs permission to use FUSE.",
  "disciplines": [
    "memory-forensics"
  ],
  "capabilities": [
    "memory-analysis",
    "visualisation",
    "data-export"
  ],
  "use_cases": [
    "incident-response",
    "forensic-triage",
    "threat-hunting"
  ],
  "evidence": [
    "memory-images"
  ],
