{
  "schema_version": 1,
  "id": "velociraptor",
  "name": "Velociraptor",
  "kind": "tool",
  "description": "Collect forensic artifacts from a machine, or from many at once, using a query language built for the job.",
  "about": "Velociraptor collects evidence by asking questions rather than copying everything. Artifacts are written in its own query language, so a collection describes what is wanted -- these registry keys, these event log entries, files matching this pattern, processes with this characteristic -- and returns only that. The same executable runs three ways: as a single collector against the machine it is on, as a server with agents reporting to it, or packaged into a standalone collector that can be handed to somebody with no other tooling. Hundreds of artifact definitions ship inside the binary, covering common Windows, Linux and macOS evidence, and results come back as CSV or JSON. Server and agent modes reach across a network, so what a given invocation does is worth reading before running it. The x64 Linux build is statically linked, so it does not depend on the distribution's C library; the arm64 build needs glibc 2.28 or newer.",
  "disciplines": [
    "windows-forensics"
  ],
  "capabilities": [
    "evidence-collection",
    "data-export"
  ],
  "use_cases": [
    "incident-response",
    "threat-hunting",
    "compromise-assessment"
  ],
  "evidence": [
    "files",
    "registry-hives",
    "windows-event-logs"
  ],
