{
  "schema_version": 1,
  "id": "yara-x",
  "name": "YARA-X",
  "kind": "tool",
  "description": "Scan files for YARA rules with the rewritten YARA engine and its yr command.",
  "about": "YARA-X is a rewrite of YARA that reads the same rule language, so existing rule sets mostly work unchanged, though a few rarely used constructs behave differently or are refused. Its single command, yr, scans files and directories, compiles rules ahead of time, checks and formats rule files, and can dump what its modules extract from a file, such as the structure of a PE or ELF executable. Matches can be printed as text or as newline-delimited JSON for further processing. Unlike YARA, it does not scan the memory of running processes. The Linux builds are statically linked.",
  "disciplines": [
    "malware-analysis"
  ],
  "capabilities": [
    "signature-scanning"
  ],
  "use_cases": [
    "threat-hunting",
    "incident-response"
  ],
