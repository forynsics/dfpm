{
  "schema_version": 1,
  "id": "velociraptor",
  "provider": "github-releases",
  "repository": "Velocidex/velociraptor",
  "tag_prefix": "v",
  "assets": [
    {
      "name": "velociraptor-v{version}-windows-amd64.exe",
      "platform": {"os": "windows", "arch": "x64"}
    },
    {
      "name": "velociraptor-v{version}-linux-amd64-musl",
      "platform": {"os": "linux", "arch": "x64"}
    },
    {
      "name": "velociraptor-v{version}-linux-arm64",
      "platform": {"os": "linux", "arch": "arm64"}
    }
  ]
}
