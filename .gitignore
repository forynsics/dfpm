# Project-local Python environment
.venv/

# Python-generated files
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example
AGENTS.md
CLAUDE.md
CLAUDE.local.md
.claude/
.local/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated files
dist/
build/
coverage/

# dfpm's own data, in case the tool is ever pointed at this repository with --root .
# Command shims embed absolute paths, so committing these would leak a home directory.
/tools/
/cache/
/state/
/staging/
/bin/
*.lock.json

# Manufactured from catalog/, never edited by hand.
# The wheel build stages the entries; the Pages deploy generates the site feed.
/src/dfpm/entries/
/docs/catalog.json
