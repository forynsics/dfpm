{
  "schema_version": 1,
  "id": "evtxecmd",
  "name": "EvtxECmd",
  "kind": "tool",
  "description": "Parse Windows event logs into one consistent set of columns across every provider.",
  "about": "EvtxECmd reads Windows .evtx logs and normalises them, so that events written by different providers end up in the same shape rather than each carrying its own XML payload. Map files stored beside the executable say which fields are worth pulling out for a given provider and event ID; an event with no map is still reported, with its payload intact. Output is CSV, JSON or XML, and a whole directory of logs can be processed into one file.",
  "disciplines": [
    "windows-forensics"
  ],
  "capabilities": [
    "event-log-parsing",
    "timeline-generation",
    "data-export"
  ],
  "use_cases": [
    "incident-response",
    "threat-hunting",
    "forensic-triage"
  ],
  "evidence": [
    "windows-event-logs"
  ],
