{
  "packages": [
    {
      "id": "hayabusa",
      "name": "Hayabusa",
      "kind": "tool",
      "description": "Analyze Windows event logs, build forensic timelines, and apply Sigma-based detections.",
      "version": "4.0.0",
      "versions": [
        "4.0.0"
      ],
      "platforms": [
        {
          "os": "windows",
          "arch": "x64"
        },
        {
          "os": "linux",
          "arch": "x64"
        },
        {
          "os": "macos",
          "arch": "arm64"
        }
      ],
      "about": "Hayabusa reads a directory of Windows .evtx files and produces a single consolidated timeline, applying bundled Sigma detection rules as it goes so that matching activity is labelled with a severity. It supports the Sigma specification including v2 correlation rules, and can output to CSV, JSON and several other formats for review in other tools. The detection rules ship with the release and can be updated separately from the binary.",
      "disciplines": [
        {
          "key": "windows-forensics",
          "label": "Windows forensics"
        }
      ],
      "capabilities": [
        {
          "key": "event-log-parsing",
          "label": "Event log parsing"
        },
        {
          "key": "timeline-generation",
          "label": "Timeline generation"
        },
        {
          "key": "sigma-detection",
          "label": "Sigma rule detection"
        },
        {
          "key": "data-export",
          "label": "Data export"
        }
      ],
      "use_cases": [
        {
          "key": "forensic-triage",
          "label": "Forensic triage"
        },
        {
          "key": "incident-response",
          "label": "Incident response"
        },
        {
          "key": "threat-hunting",
          "label": "Threat hunting"
        }
      ],
      "evidence": [
        {
          "key": "windows-event-logs",
          "label": "Windows event logs"
        }
      ],
      "commands": [
        "hayabusa"
      ],
      "project": {
        "homepage": "https://yamato-security.github.io/hayabusa/",
        "repository": "https://github.com/Yamato-Security/hayabusa",
        "license": "AGPL-3.0-only AND LicenseRef-DRL-1.1"
      }
    },
    {
      "id": "yara",
      "name": "YARA",
      "kind": "tool",
      "description": "Scan files and memory for rules describing textual or binary patterns.",
      "version": "4.5.5",
      "versions": [
        "4.5.5"
      ],
      "platforms": [
        {
          "os": "windows",
          "arch": "x64"
        }
      ],
      "about": "YARA matches files, directories and running processes against rules that describe the strings and byte sequences a family of software contains. Each match is reported with the rule that fired and where in the file it occurred. Rules are plain text and portable, so detections written by one team can be applied unchanged by another, and the same rule set can be run over collected files or over a memory image.",
      "disciplines": [
        {
          "key": "malware-analysis",
          "label": "Malware analysis"
        }
      ],
      "capabilities": [
        {
          "key": "signature-scanning",
          "label": "Signature scanning"
        },
        {
          "key": "string-extraction",
          "label": "String extraction"
        }
      ],
      "use_cases": [
        {
          "key": "threat-hunting",
          "label": "Threat hunting"
        },
        {
          "key": "incident-response",
          "label": "Incident response"
        }
      ],
      "evidence": [
        {
          "key": "files",
          "label": "Files of any kind"
        },
        {
          "key": "memory-images",
          "label": "Memory images"
        }
      ],
      "commands": [
        "yara",
        "yarac"
      ],
      "project": {
        "homepage": "https://virustotal.github.io/yara/",
        "repository": "https://github.com/VirusTotal/yara",
        "license": "BSD-3-Clause"
      }
    }
  ],
